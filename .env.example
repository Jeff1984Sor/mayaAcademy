# Copie para .env no servidor e preencha. O .env NUNCA vai para o Git (R5).

SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=False
# hml (homologação) ou prod
AMBIENTE=prod
ALLOWED_HOSTS=academy.mayacorp.com.br
CSRF_TRUSTED_ORIGINS=https://academy.mayacorp.com.br
SITE_URL=https://academy.mayacorp.com.br

# PostgreSQL dedicado (banco e usuário próprios da MayaAcademy — R3)
DB_NAME=mayaacademy
DB_USER=mayaacademy
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis com DB index exclusivo (não usar o índice de outro app)
CELERY_BROKER_URL=redis://127.0.0.1:6380/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6380/0
CACHE_URL=redis://127.0.0.1:6380/1

# Diretórios
MEDIA_ROOT=/home/deploy/mayaacademy/media
STATIC_ROOT=/home/deploy/mayaacademy/staticfiles
LOG_DIR=/home/deploy/mayaacademy/logs

# TTS: "google" (Google Cloud Text-to-Speech via API key) ou "nulo" (sem áudio; legendas cronometradas)
TTS_PROVIDER=nulo
GOOGLE_TTS_API_KEY=

# E-mail (SMTP)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=MayaAcademy <nao-responda@mayacorp.com.br>

TTS_PRECO_1M_CARACTERES=16

# IA do gerador de curso por PDF (F2.5): OpenAI
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Modelo da sua conta OpenAI que aceita saída estruturada (json_schema)
OPENAI_MODEL=
# Preço desse modelo em US$ por 1 milhão de tokens (só para o painel de custo)
LLM_PRECO_ENTRADA_1M=0
LLM_PRECO_SAIDA_1M=0
PDF_LIMITE_PAGINAS=300

# Pagamentos (F6): manual até escolher o gateway; segredo do webhook (gere um valor longo)
PAGAMENTOS_GATEWAY=manual
PAGAMENTOS_WEBHOOK_SEGREDO=
